# Salin ke /etc/smart-vision-jteit/env lalu: chown root:presensi ...; chmod 640 ...
# JANGAN di-commit ke repositori setelah diisi.

DB_PATH=/var/lib/smart-vision-jteit/presensi.db
MODEL_DIR=/opt/smart-vision-jteit/models
TZ=Asia/Makassar

# Kunci perangkat kamera kelas. Buat dengan: openssl rand -hex 32
API_KEY=GANTI_DENGAN_KUNCI_ACAK

# Pendaftaran wajah hanya lewat verifikasi gerak kepala (disarankan di produksi)
WAJIB_HIDUP_AKTIF_DAFTAR=1

# Server berada di balik HTTPS (Nginx): paksa cookie login Secure
COOKIE_AMAN=1

# Ambang (bawaan); kalibrasi setelah uji coba kelas
AMBANG_KEMIRIPAN=0.363
AMBANG_HIDUP=0.5
